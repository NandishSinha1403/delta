// 01-LANGUAGE.md §5.6, verbatim: the canonical record form every literal desugars to.
let N = machine nfa {
  states   { 0, 1, 2, 3 }
  alphabet { 0, 1 }
  start    0
  accept   { 3 }
  edges    [ (0, '1', 1), (1, ε, 2), (2, '0', 3) ]
}
check N accepts "10"
check N rejects "", "1", "0", "01", "100"
