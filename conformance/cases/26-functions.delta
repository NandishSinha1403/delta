// 01-LANGUAGE.md §8, "Functions and statements" (the `…` bodies filled in).
fn add(a, b) = a + b                       // expression body
fn name(a: word, k: int) -> bool {         // block body, optional types
  if k == 0 { return true }
  return name(a, k - 1)
}
let f = fn(x) = x + 1                      // anonymous

let x = 3        var y = 0      y = y + 1
assert add(2, 3) == 5
assert name("ab", 3)
assert f(x) == 4
assert y == 1

var total = 0
for i ∈ 0..=3 { total = total + i }
for i in 0..3 { total = total + i }
assert total == 9
if total > 10 { print "big" } else if total > 5 { print "medium" } else { print "small" }
var n = 0
while n < 3 { n = n + 1 }
assert n == 3
