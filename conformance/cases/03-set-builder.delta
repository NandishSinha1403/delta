// 01-LANGUAGE.md §3, "Set-builder notation" and "Word sets".
// Context (not in the spec): M (with a state named dead), A, B, R, Σ and words are defined
// here so the spec's four expressions can be evaluated.
dfa M {
  alphabet a, b
  start q0
  accept q1
  q0 -a-> q1
  q1 -a-> dead
  dead -a-> dead
  q0 -b-> q0
  q1 -b-> q1
  dead -b-> dead
}
dfa A {
  alphabet a
  start [0]
  accept [1]
  [0] -a-> [1]
  [1] -a-> [0]
}
let B = M
let R = M.states
let Σ = M.alphabet
let words = ["", "a", "ab"]

// The spec's examples
assert { q ∈ M.states | q ∉ M.accept } == {:q0, :dead}
assert { (p, q) | p ∈ A.states, q ∈ B.states } == {(0, :q0), (0, :q1), (0, :dead), (1, :q0), (1, :q1), (1, :dead)}
assert { M.δ(q, a) | q ∈ R, a ∈ Σ, q ≠ :dead } == {:q0, :q1, :dead}
assert [ len(w) | w ∈ words ] == [0, 1, 2]

// Σ^n and Σ^≤n are finite sets of words
assert Σ^2 == {"aa", "ab", "ba", "bb"}
assert Σ^≤1 == {"", "a", "b"}
