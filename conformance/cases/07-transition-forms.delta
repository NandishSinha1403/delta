// 01-LANGUAGE.md §5.2: four equivalent transition forms build the same machine.
// Context: one machine ("contains ab") written three ways.
dfa A {
  start q0
  accept q2
  q0 -a-> q1
  q0 -b-> q0
  q1 -a-> q1
  q1 -b-> q2
  q2 -[a, b]-> q2
}
dfa B {
  start q0
  accept q2
  δ(q0, a) = q1
  δ(q0, b) = q0
  δ(q1, a) = q1
  δ(q1, b) = q2
  δ(q2, a) = q2
  δ(q2, b) = q2
}
dfa C {
  start q0
  accept q2
  δ = table {
       | a  | b
    q0 | q1 | q0
    q1 | q1 | q2
    q2 | q2 | q2
  }
}
assert A == B
assert A == C
check A ≡ B
check A ≡ C
check A accepts "ab", "bab", "aab"
check A rejects "", "a", "ba", "bbb"
