// Figure 1.6 — M1 accepts every string that contains at least one 1
// and an even number of 0s following the last 1 (Example 1.7).
dfa M1 {
  Q  = { q1, q2, q3 }
  Σ  = { 0, 1 }
  δ  = table {
          | 0  | 1
       q1 | q1 | q2
       q2 | q3 | q2
       q3 | q2 | q2
  }
  q0 = q1
  F  = { q2 }
}

check M1 accepts "1", "01", "11", "0101010101", "100", "0100", "110000"
check M1 rejects "", "0", "10", "1000", "101000"
run M1 on "1101"
