// Theorem 1.25 — the class of regular languages is closed under union: the product construction.
// M1 (Example 1.9) accepts strings ending in 1; M2 accepts strings with an even number of 0s.
dfa M1 {
  Q = { q1, q2 }
  Σ = { 0, 1 }
  δ = table {
       | 0  | 1
    q1 | q1 | q2
    q2 | q1 | q2
  }
  q0 = q1
  F  = { q2 }
}

dfa M2 {
  Q = { even, odd }
  Σ = { 0, 1 }
  δ = table {
         | 0    | 1
    even | odd  | even
    odd  | even | odd
  }
  q0 = even
  F  = { even }
}

// Q = Q1 × Q2 (reachable pairs), q0 = (q1, even), F = (F1 × Q2) ∪ (Q1 × F2).
let M = union(M1, M2)

check M accepts "", "1", "00", "01", "0011", "101"
check M rejects "0", "10", "000", "1000"
