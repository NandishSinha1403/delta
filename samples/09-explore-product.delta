// Constructions as code — the product construction written with explore
dfa A {
  start e
  accept e
  e -a-> o;   e -b-> e
  o -a-> e;   o -b-> o
}
dfa B {
  start n
  accept y
  n -a-> n;   n -b-> y
  y -a-> n;   y -b-> y
}
fn product(A, B, keep) = explore {
  alphabet A.alphabet ∪ B.alphabet
  start  (A.start, B.start)
  step   (p, q) on a -> (A.δ(p, a), B.δ(q, a))
  accept (p, q) if keep(p ∈ A.accept, q ∈ B.accept)
}
let both = product(A, B, fn(x, y) = x and y)
check both ≡ intersect(A, B)
show both
