// Divisible by n — a DFA generated by a function: states are numbers
fn divisible_by(n) = dfa {
  alphabet 0, 1
  start  [0]
  accept [0]
  for r ∈ 0..n {
    [r] -0-> [(2*r) % n]
    [r] -1-> [(2*r + 1) % n]
  }
}
let M = divisible_by(3)
check M accepts "0", "11", "110", "1001"
check M rejects "1", "10", "111"
assert M.size == 3
assert M.δ(1, '0') == 2
run M on "1001"
